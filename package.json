{
  "name": "@tihonove/agent-office",
  "version": "0.0.4",
  "description": "Офис агентов: проект объявляет манифест, офис его применяет поверх журнала фактов",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tihonove/agent-office.git"
  },
  "type": "module",
  "bin": {
    "agent-office": "dist/agent-office.js"
  },
  "files": [
    "dist/agent-office.js",
    "dist/manifest.schema.json",
    "docs/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test -w @agent-office/office",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "start": "node packages/office/src/main.ts",
    "dev": "npm run dev -w @agent-office/dashboard",
    "schema": "ts-json-schema-generator --path packages/shared/src/manifest.ts --type Manifest --tsconfig packages/shared/tsconfig.json --no-type-check --out packages/shared/manifest.schema.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "office": "npm run build -w @agent-office/dashboard || { echo '✗ дашборда не собралась — офис не поднимаю, ошибка выше' >&2; exit 1; } && node packages/office/src/main.ts .",
    "stand": "node scripts/stand.ts",
    "bundle": "node scripts/bundle.ts",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run bundle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  }
}
